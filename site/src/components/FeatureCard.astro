---
import Icon from './Icon.astro';
interface Props { title: string; tick?: string; icon?: string; }
const { title, tick, icon } = Astro.props;
---
<article class="card rev">
  {icon && <span class="cardicon"><Icon name={icon} size={20} /></span>}
  {tick && <div class="tick">{tick}</div>}
  <h3>{title}</h3>
  <p><slot /></p>
</article>
