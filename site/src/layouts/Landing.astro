---
import '../styles/landing.css';
import { getStars, formatStars } from '../lib/github';
interface Props { title?: string; description?: string; }
const {
  title = 'right agent',
  description = 'an ai agent you run by messaging it. credentials stay outside the box.',
} = Astro.props;
const starLabel = formatStars(await getStars());
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <div class="fx void"></div>
    <div class="fx depthbloom" data-depth="4"></div>
    <div class="fx nebula" data-depth="6"></div>
    <div class="fx stars-far twinkle" data-depth="16"></div>
    <div class="fx stars-near" data-depth="30"></div>
    <div class="fx ceiling"></div>
    <div class="fx horizon"></div>
    <div class="fx horizon-glow"></div>
    <div class="fx grain"></div>
    <div class="fx scan"></div>

    <div class="hud" aria-hidden="true">
      <span class="edge tl"></span><span class="edge tr"></span><span class="edge bl"></span><span class="edge br"></span>
      <span class="read r-bl">secure-by-default</span>
    </div>

    <div class="wrap">
      <nav class="topnav">
        <a class="brand" href="/" aria-label="right agent">
          <span class="clawwrap">
            <svg class="claw" width="30" height="30" viewBox="0 0 100 100" aria-hidden="true">
              <path d="M14 42 L48 22 Q56 18 62 22 L84 36" stroke-width="8.5" stroke-linecap="round" fill="none"/>
              <path d="M14 58 L48 78 Q56 82 62 78 L84 64" stroke-width="8.5" stroke-linecap="round" fill="none"/>
              <rect x="8" y="38" width="11" height="24" rx="5.5"/>
              <path class="chk" d="M38 50 L46 58 L64 40" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
          <span class="wm"><span class="r">right</span> <span class="a">agent</span></span>
        </a>
        <div class="navlinks">
          <a href="/docs/">docs</a>
          <a href="#install">install</a>
          <a class="starchip" href="https://github.com/onsails/right-agent" aria-label="Star right agent on GitHub">
            <svg class="ico" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7L12 18.3 5.8 21.2l1.6-7L2 9.5l7.1-.6z"/></svg>
            <span>{starLabel ? `star · ${starLabel}` : 'star'}</span>
          </a>
        </div>
      </nav>
    </div>

    <slot />

    <!-- FX-EXPERIMENT:start -->
    <div class="fxswitch" data-fx-switcher aria-label="Scroll effect comparison">
      <div class="fxswitch-labels">
        <span class="fxswitch-kicker">scroll fx</span>
        <span class="fxswitch-note">live compare</span>
      </div>
      <div class="fxswitch-actions" role="group" aria-label="Scroll effect variants">
        <button type="button" class="fxswitch-btn" data-fx-choice="a" aria-pressed="false">
          <span class="fxswitch-key">A</span>
          <span class="fxswitch-text">scale-in</span>
        </button>
        <button type="button" class="fxswitch-btn" data-fx-choice="b" aria-pressed="false">
          <span class="fxswitch-key">B</span>
          <span class="fxswitch-text">focus</span>
        </button>
        <button type="button" class="fxswitch-btn" data-fx-choice="c" aria-pressed="false">
          <span class="fxswitch-key">C</span>
          <span class="fxswitch-text">spotlight</span>
        </button>
      </div>
    </div>
    <!-- FX-EXPERIMENT:end -->

    <script>
      const layers = Array.from(document.querySelectorAll('.fx[data-depth]')) as HTMLElement[];
      const zoomTargets = Array.from(document.querySelectorAll('.card, .flow, .evolve, .section h2')) as HTMLElement[];
      const sections = Array.from(document.querySelectorAll('.section')) as HTMLElement[];
      const switcher = document.querySelector('[data-fx-switcher]') as HTMLElement | null;
      const switcherButtons = Array.from(document.querySelectorAll('[data-fx-choice]')) as HTMLButtonElement[];
      let mx = 0, my = 0, sy = 0, tmx = 0, tmy = 0;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* FX-EXPERIMENT:start */
      const FX_KEY = 'fx';
      const FX_DEFAULT = 'a';
      const isFxChoice = (value: string | null | undefined): value is 'a' | 'b' | 'c' => value === 'a' || value === 'b' || value === 'c';
      const getStoredFx = () => {
        const value = localStorage.getItem(FX_KEY);
        return isFxChoice(value) ? value : FX_DEFAULT;
      };
      const clearZoomTargets = () => {
        for (const el of zoomTargets) el.style.scale = '';
      };
      let activeSection: HTMLElement | null = null;
      const clearActiveSection = () => {
        if (activeSection) {
          activeSection.removeAttribute('data-active');
          activeSection = null;
        }
        for (const section of sections) section.removeAttribute('data-active');
      };
      let activeFx: 'a' | 'b' | 'c' = FX_DEFAULT;
      const setFx = (nextFx: 'a' | 'b' | 'c') => {
        const prevFx = activeFx;
        activeFx = nextFx;
        document.documentElement.dataset.fx = nextFx;
        localStorage.setItem(FX_KEY, nextFx);
        for (const btn of switcherButtons) btn.setAttribute('aria-pressed', String(btn.dataset.fxChoice === nextFx));
        if (prevFx === 'b' && nextFx !== 'b') clearZoomTargets();
        if (prevFx === 'c' && nextFx !== 'c') clearActiveSection();
      };
      if (switcher) {
        if (reduce) {
          switcher.hidden = true;
        } else {
          setFx(getStoredFx());
          switcher.addEventListener('click', (event) => {
            const button = (event.target as HTMLElement | null)?.closest('[data-fx-choice]') as HTMLButtonElement | null;
            const nextFx = button?.dataset.fxChoice;
            if (!isFxChoice(nextFx) || nextFx === activeFx) return;
            setFx(nextFx);
          });
        }
      }
      if (!switcher && !reduce) setFx(getStoredFx());
      /* FX-EXPERIMENT:end */

      addEventListener('scroll', () => { sy = scrollY; }, { passive: true });
      if (!reduce) {
        addEventListener('mousemove', (e) => {
          tmx = (e.clientX / innerWidth - .5) * 2;
          tmy = (e.clientY / innerHeight - .5) * 2;
        }, { passive: true });
        const tick = () => {
          mx += (tmx - mx) * .06; my += (tmy - my) * .06;
          for (const el of layers) {
            const d = parseFloat(el.dataset.depth || '0');
            el.style.transform = `translate3d(${(-mx * d).toFixed(2)}px, ${(-my * d - sy * (d / 90)).toFixed(2)}px, 0)`;
          }

          if (activeFx === 'b') {
            const viewportCenter = innerHeight / 2;
            const scales = zoomTargets.map((el) => {
              const rect = el.getBoundingClientRect();
              const center = rect.top + rect.height / 2;
              const distance = Math.min(Math.abs(center - viewportCenter) / (innerHeight * .72), 1);
              const focus = 1 - distance;
              const eased = focus * focus * (3 - 2 * focus);
              return 0.96 + eased * 0.08;
            });
            for (const [index, el] of zoomTargets.entries()) el.style.scale = scales[index].toFixed(4);
          }

          if (activeFx === 'c') {
            const viewportCenter = innerHeight / 2;
            let nearest: HTMLElement | null = null;
            let nearestDistance = Number.POSITIVE_INFINITY;
            for (const section of sections) {
              const rect = section.getBoundingClientRect();
              const center = rect.top + rect.height / 2;
              const distance = Math.abs(center - viewportCenter);
              if (distance < nearestDistance) {
                nearestDistance = distance;
                nearest = section;
              }
            }
            if (nearest !== activeSection) {
              clearActiveSection();
              if (nearest) {
                nearest.dataset.active = 'true';
                activeSection = nearest;
              }
            }
          }

          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: .12 });
      document.querySelectorAll('.rev:not(.in)').forEach((el) => io.observe(el));
      document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
        c.addEventListener('mousemove', (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty('--gx', (e.clientX - r.left) + 'px');
          c.style.setProperty('--gy', (e.clientY - r.top) + 'px');
        }, { passive: true });
      });
    </script>
  </body>
</html>
