---
import '../styles/landing.css';
import { getStars, formatStars } from '../lib/github';
interface Props { title?: string; description?: string; }
const {
  title = 'right agent',
  description = 'an ai agent you run by messaging it. credentials stay outside the box.',
} = Astro.props;
const starLabel = formatStars(await getStars());
---
<!doctype html>
<html lang="en" data-tex="fiber" data-tone="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <div class="fx void"></div>
    <!-- PAPER-EXPERIMENT:start -->
    <div class="fx paper" aria-hidden="true"></div>
    <svg class="paper-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <filter id="paper-fiber" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" result="noise" />
          <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
          <feComponentTransfer in="mono">
            <feFuncR type="gamma" amplitude="1" exponent="0.9" offset="0" />
            <feFuncG type="gamma" amplitude="1" exponent="0.9" offset="0" />
            <feFuncB type="gamma" amplitude="1" exponent="0.9" offset="0" />
            <feFuncA type="table" tableValues="0 0.72" />
          </feComponentTransfer>
        </filter>
        <filter id="paper-cardstock" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.4" numOctaves="2" stitchTiles="stitch" result="noise" />
          <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
          <feComponentTransfer in="mono">
            <feFuncR type="gamma" amplitude="1.18" exponent="0.82" offset="0" />
            <feFuncG type="gamma" amplitude="1.18" exponent="0.82" offset="0" />
            <feFuncB type="gamma" amplitude="1.18" exponent="0.82" offset="0" />
            <feFuncA type="table" tableValues="0 0.86" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <!-- PAPER-EXPERIMENT:end -->
    <div class="fx depthbloom" data-depth="4"></div>
    <div class="fx nebula" data-depth="6"></div>
    <div class="fx bgfx bgfx-telemetry bgfx-telemetry-1" data-depth="10" aria-hidden="true">
      <div class="bgtelem-col">
        <span>obs · deep-field</span>
        <span>sig <i class="bgtelem-flicker">●●●●●</i></span>
        <span>lat 12ms</span>
        <span>0x7f3a · sandbox</span>
        <span>RA 14h · DEC +12°</span>
        <span>coord 41.2 / 73.9</span>
      </div>
      <div class="bgtelem-col">
        <span>agent runtime · nominal</span>
        <span>hex 4d 41 50 2f 31</span>
        <span>vault ext · sealed</span>
        <span>sig <i class="bgtelem-flicker bgtelem-flicker-alt">●●●●●</i></span>
        <span>obs · low-noise</span>
        <span>0x11bd · host rail</span>
      </div>
      <div class="bgtelem-col">
        <span>RA 02h · DEC -04°</span>
        <span>lat 09ms · stable</span>
        <span>coord 08.6 / 12.4</span>
        <span>sig ●●●○○</span>
        <span>obs · deep-field</span>
        <span>0x92aa · link clear</span>
      </div>
    </div>
    <div class="fx bgfx bgfx-telemetry bgfx-telemetry-2" data-depth="18" aria-hidden="true">
      <div class="bgtelem-row">
        <span>north vector · 18.4</span><span>RA 14h · DEC +12°</span><span>lat 12ms</span><span>sig <i class="bgtelem-flicker">●●●●●</i></span><span>obs · deep-field</span><span>0x7f3a · nominal</span>
      </div>
      <div class="bgtelem-row">
        <span>coord 41.2 / 73.9</span><span>channel · sealed</span><span>lat 09ms</span><span>obs · quiet-band</span><span>0x4be1 · uplink</span><span>sig ●●●○○</span>
      </div>
      <div class="bgtelem-row">
        <span>fig 02 · proxy rail</span><span>RA 02h · DEC -04°</span><span>hex 5a 31 63</span><span>obs · deep-field</span><span>lat 16ms</span><span>sig <i class="bgtelem-flicker bgtelem-flicker-alt">●●●●○</i></span>
      </div>
    </div>
    <div class="fx ceiling"></div>
    <div class="fx horizon"></div>
    <div class="fx horizon-glow"></div>
    <div class="fx scan"></div>

    <div class="hud" aria-hidden="true">
      <span class="edge tl"></span><span class="edge tr"></span><span class="edge bl"></span><span class="edge br"></span>
      <span class="read r-bl">secure-by-default</span>
    </div>

    <!-- PAPER-EXPERIMENT:start -->
    <div class="paper-switch" aria-label="Paper experiment switcher">
      <div class="paper-row">
        <span class="paper-label">texture</span>
        <div class="paper-choices">
          <button type="button" class="paper-chip" data-tex-choice="fiber" aria-pressed="false">fiber</button>
          <button type="button" class="paper-chip" data-tex-choice="cardstock" aria-pressed="false">cardstock</button>
          <button type="button" class="paper-chip" data-tex-choice="halftone" aria-pressed="false">halftone</button>
          <button type="button" class="paper-chip" data-tex-choice="crosshatch" aria-pressed="false">crosshatch</button>
        </div>
      </div>
      <div class="paper-row">
        <span class="paper-label">tone</span>
        <div class="paper-choices">
          <button type="button" class="paper-chip" data-tone-choice="dark" aria-pressed="false">dark</button>
          <button type="button" class="paper-chip" data-tone-choice="warm" aria-pressed="false">warm</button>
        </div>
      </div>
    </div>
    <!-- PAPER-EXPERIMENT:end -->

    <div class="wrap">
      <nav class="topnav">
        <a class="brand" href="/" aria-label="right agent">
          <span class="clawwrap">
            <svg class="claw" width="30" height="30" viewBox="0 0 100 100" aria-hidden="true">
              <path d="M14 42 L48 22 Q56 18 62 22 L84 36" stroke-width="8.5" stroke-linecap="round" fill="none"/>
              <path d="M14 58 L48 78 Q56 82 62 78 L84 64" stroke-width="8.5" stroke-linecap="round" fill="none"/>
              <rect x="8" y="38" width="11" height="24" rx="5.5"/>
              <path class="chk" d="M38 50 L46 58 L64 40" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
          <span class="wm"><span class="r">right</span> <span class="a">agent</span></span>
        </a>
        <div class="navlinks">
          <a href="/docs/">docs</a>
          <a href="#install">install</a>
          <a class="starchip" href="https://github.com/onsails/right-agent" aria-label="Star right agent on GitHub">
            <svg class="ico" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7L12 18.3 5.8 21.2l1.6-7L2 9.5l7.1-.6z"/></svg>
            <span>{starLabel ? `star · ${starLabel}` : 'star'}</span>
          </a>
        </div>
      </nav>
    </div>

    <slot />

    <script>
      const layers = Array.from(document.querySelectorAll('.fx[data-depth]')) as HTMLElement[];
      const sections = Array.from(document.querySelectorAll('.section')) as HTMLElement[];
      /* PAPER-EXPERIMENT:start */
      const root = document.documentElement;
      const texChoices = ['fiber', 'cardstock', 'halftone', 'crosshatch'];
      const toneChoices = ['dark', 'warm'];
      const texButtons = Array.from(document.querySelectorAll('[data-tex-choice]')) as HTMLButtonElement[];
      const toneButtons = Array.from(document.querySelectorAll('[data-tone-choice]')) as HTMLButtonElement[];
      const setTexChoice = (next: string, persist = true) => {
        const choice = texChoices.includes(next) ? next : 'fiber';
        root.dataset.tex = choice;
        for (const button of texButtons) button.setAttribute('aria-pressed', String(button.dataset.texChoice === choice));
        if (persist) {
          try {
            localStorage.setItem('tex', choice);
          } catch {}
        }
      };
      const setToneChoice = (next: string, persist = true) => {
        const choice = toneChoices.includes(next) ? next : 'dark';
        root.dataset.tone = choice;
        for (const button of toneButtons) button.setAttribute('aria-pressed', String(button.dataset.toneChoice === choice));
        if (persist) {
          try {
            localStorage.setItem('tone', choice);
          } catch {}
        }
      };
      let storedTex = 'fiber';
      let storedTone = 'dark';
      try {
        storedTex = localStorage.getItem('tex') || 'fiber';
        storedTone = localStorage.getItem('tone') || 'dark';
      } catch {}
      setTexChoice(storedTex, false);
      setToneChoice(storedTone, false);
      for (const button of texButtons) {
        button.addEventListener('click', () => setTexChoice(button.dataset.texChoice || 'fiber'));
      }
      for (const button of toneButtons) {
        button.addEventListener('click', () => setToneChoice(button.dataset.toneChoice || 'dark'));
      }
      /* PAPER-EXPERIMENT:end */
      let mx = 0, my = 0, sy = 0, tmx = 0, tmy = 0;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeSection: HTMLElement | null = null;
      const clearActiveSection = () => {
        if (activeSection) {
          activeSection.removeAttribute('data-active');
          activeSection = null;
        }
        for (const section of sections) section.removeAttribute('data-active');
      };
      const updateActiveSection = () => {
        const viewportCenter = innerHeight / 2;
        let nearest: HTMLElement | null = null;
        let nearestDistance = Number.POSITIVE_INFINITY;
        for (const section of sections) {
          const rect = section.getBoundingClientRect();
          const center = rect.top + rect.height / 2;
          const distance = Math.abs(center - viewportCenter);
          if (distance < nearestDistance) {
            nearestDistance = distance;
            nearest = section;
          }
        }
        if (nearest !== activeSection) {
          clearActiveSection();
          if (nearest) {
            nearest.dataset.active = 'true';
            activeSection = nearest;
          }
        }
      };

      addEventListener('scroll', () => { sy = scrollY; }, { passive: true });
      if (!reduce) {
        addEventListener('mousemove', (e) => {
          tmx = (e.clientX / innerWidth - .5) * 2;
          tmy = (e.clientY / innerHeight - .5) * 2;
        }, { passive: true });
      }

      const tick = () => {
        if (!reduce) {
          mx += (tmx - mx) * .06; my += (tmy - my) * .06;
          for (const el of layers) {
            const d = parseFloat(el.dataset.depth || '0');
            el.style.transform = `translate3d(${(-mx * d).toFixed(2)}px, ${(-my * d - sy * (d / 90)).toFixed(2)}px, 0)`;
          }
        }
        updateActiveSection();

        requestAnimationFrame(tick);
      };
      updateActiveSection();
      requestAnimationFrame(tick);
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: .12 });
      document.querySelectorAll('.rev:not(.in)').forEach((el) => io.observe(el));
      document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
        c.addEventListener('mousemove', (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty('--gx', (e.clientX - r.left) + 'px');
          c.style.setProperty('--gy', (e.clientY - r.top) + 'px');
        }, { passive: true });
      });
    </script>
  </body>
</html>
